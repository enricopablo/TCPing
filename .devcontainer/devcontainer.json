{
  "name": "TCPing (Python + uv)",
  "image": "ghcr.io/astral-sh/uv:python3.13-trixie-slim",
  "features": {
    // git do Debian (apt), em vez de compilar do código-fonte
    "ghcr.io/devcontainers/features/git:1": { "version": "os-provided" }
  },
  "postCreateCommand": "uv sync",
  "containerEnv": {
    "TZ": "America/Sao_Paulo"
  },

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "ms-python.python",
        "ms-python.vscode-pylance"]
    }
  }
}